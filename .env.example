SECRET_KEY=change-me-to-a-32-plus-character-random-string
DATABASE_URL=sqlite:///./minimart.db
ENV=development
DEBUG=True

# Midtrans — get these from https://dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=False

# Postgres reporting mirror — a read-only copy of the SQLite DB for Looker Studio.
# SQLite stays the production database; scripts/sync_to_postgres.py copies rows
# into Postgres every 15 min. Leave REPORTING_DATABASE_URL blank to disable it.
POSTGRES_USER=minimart
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=minimart_reporting
# The app/sync job connect as POSTGRES_USER over the Docker network (host "postgres"):
REPORTING_DATABASE_URL=postgresql+psycopg://minimart:change-me-strong-password@postgres:5432/minimart_reporting
# Separate least-privilege login Looker Studio uses (SELECT only):
LOOKER_RO_PASSWORD=change-me-different-password

# Cloudflare R2 — get these from the Cloudflare dashboard → R2 Object Storage.
# Leave all blank to use local disk storage (uploads/products/) instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=minimart-products
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
