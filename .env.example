SECRET_KEY=change-me-to-a-32-plus-character-random-string
# Local dev: run `docker compose up -d postgres` and use the published 5433 port.
# On the server this is set to the in-network host: postgres:5432/minimart
DATABASE_URL=postgresql+psycopg://minimart:change-me-strong-password@localhost:5433/minimart
ENV=development
DEBUG=True

# Midtrans — get these from https://dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=False

# Postgres — production database, and the source Looker Studio connects to.
POSTGRES_USER=minimart
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=minimart
# Least-privilege login Looker Studio uses (SELECT only, created on first boot):
LOOKER_RO_PASSWORD=change-me-different-password

# Cloudflare R2 — get these from the Cloudflare dashboard → R2 Object Storage.
# Leave all blank to use local disk storage (uploads/products/) instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=minimart-products
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
